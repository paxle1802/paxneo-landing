{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "lib/fonts/**"
    }
  },
  "redirects": [
    {
      "source": "/cardcycle/:path*",
      "destination": "/memcredit/:path*",
      "permanent": true
    },
    {
      "source": "/memcard/:path*",
      "destination": "/memcredit/:path*",
      "permanent": true
    }
  ]
}
